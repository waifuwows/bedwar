            "text": "{\"code\":1,\"message\":\"SUCCESS\",\"data\":{\"gameId\":\"g1046\",\"gameTitle\":\"Bed Wars\",\"bannerPic\":[\"http://static.sandboxol.com/sandbox/games/images/g1046.起床战争en.1559047808419.png\"],\"gameDetail\":\"Welcome To Bedwars. This is a PVP game with various modes and challenges. The game starts with two or more than two team. Players need to protect their team's bed by using various blocks. Players can collect gold, diamonds and emerald to make themselves more stronger. Once all the enemies are defeated, your team will be victorious. The game includes different challenges, well designed UI, background music that enhance the gameplay, sound effects, attribute and powers-ups, different customization and accessories and prepared different props for you to defeat your enemies! Welcome warrior and start your adventure now!\",\"praiseNumber\":4674211.0,\"gameCoverPic\":\"http://staticgs.sandboxol.com/sandbox/games/images/g1046-1775016380538.png\",\"gameCoverPicOne\":null,\"gameCoverPicFour\":null,\"loadingPic\":null,\"gameCoverPicIos\":null,\"replaceIosGameCoverPicMaxVersion\":0,\"gameTypes\":[\"Action\"],\"tags\":[\"Multi-Player Competition\"],\"isPublish\":1,\"visitorEnter\":1,\"version\":648,\"engineVersion\":10114,\"packageLimited\":{},\"warmUpResponse\":{\"gameId\":\"g1046\",\"gameTitle\":\"Bed Wars\",\"gameCoverPic\":\"http://staticgs.sandboxol.com/sandbox/games/images/g1046-1775016380538.png\",\"bannerPic\":[\"http://static.sandboxol.com/sandbox/games/images/g1046.起床战争en.1559047808419.png\"],\"gameDetail\":\"Welcome To Bedwars. This is a PVP game with various modes and challenges. The game starts with two or more than two team. Players need to protect their team's bed by using various blocks. Players can collect gold, diamonds and emerald to make themselves more stronger. Once all the enemies are defeated, your team will be victorious. The game includes different challenges, well designed UI, background music that enhance the gameplay, sound effects, attribute and powers-ups, different customization and accessories and prepared different props for you to defeat your enemies! Welcome warrior and start your adventure now!\",\"isPublish\":0,\"images\":[],\"featuredPlay\":[{\"id\":24522,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片4.1558599792653.png\",\"describe\":\"1. You can open the gold chest with a key at the chest merchant and open the diamond chest with points.\"},{\"id\":24524,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.QQ图片20190524113043.1558669589608.png\",\"describe\":\"2. You can set different runes at the rune merchant.\"},{\"id\":24526,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片6.1558600421886.png\",\"describe\":\"3. You can buy and equip a variety of skins from the decoration merchant\"},{\"id\":24528,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片7.1558600536937.png\",\"describe\":\"4. You can see the details of the season, rewards and your current level on the horn season page.\"},{\"id\":24529,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片8.1558600633482.png\",\"describe\":\"5. You purchase keys, props and privileges in the shop (access shop from backpack)\"},{\"id\":24532,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片1.1558602851373.png\",\"describe\":\"6. The forge can produce resources that you and your teammate can use.\"},{\"id\":24533,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片2.1558602909452.png\",\"describe\":\"7. Only scissors can destroy enemies' bed. Players cannot respawn if their bed is destroyed\"},{\"id\":24536,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片3.1558603033678.png\",\"describe\":\"8. You can buy equipment and items with iron, gold and emeralds from the item shop.\"},{\"id\":24538,\"picUrl\":\"http://static.sandboxol.com/sandbox/games/images/g1046.图片4.1558603234430.png\",\"describe\":\"9. Upgrading equipment at the store will cost diamonds.\"}]},\"isShopOnline\":1,\"isRankOnline\":0,\"isNewEngine\":0,\"isUgcGame\":0,\"gameUgcType\":\"unknown\",\"isOpenParty\":1,\"partyMaxMembers\":0,\"gamePayInfo\":null,\"isPay\":0,\"turntableStatus\":0,\"turntableRemainCount\":0,\"gameBannerVideoInfos\":[{\"id\":1811,\"titles\":{},\"image\":\"http://staticgs.sandboxol.com/sandbox/games/images/g1046-1741661130759.png\",\"url\":\"\",\"version\":0,\"sort\":0,\"inside\":false,\"test\":false,\"fullScreen\":false,\"webview\":false},{\"id\":1812,\"titles\":{},\"image\":\"http://staticgs.sandboxol.com/sandbox/games/images/g1046-1741661172825.png\",\"url\":\"\",\"version\":0,\"sort\":1,\"inside\":false,\"test\":false,\"fullScreen\":false,\"webview\":false},{\"id\":1813,\"titles\":{},\"image\":\"http://staticgs.sandboxol.com/sandbox/games/images/g1046-1741661186452.png\",\"url\":\"\",\"version\":0,\"sort\":2,\"inside\":false,\"test\":false,\"fullScreen\":false,\"webview\":false},{\"id\":1800,\"titles\":{},\"image\":\"http://staticgs.sandboxol.com/sandbox/games/images/g1046-1725358850011.png\",\"url\":\"https://discord.gg/a5qcANejfd\",\"version\":0,\"sort\":4,\"inside\":true,\"test\":false,\"fullScreen\":false,\"webview\":true}],\"realPlayGameList\":[{\"gameId\":\"g1008\",\"gameName\":\"Bed Wars\"}],\"latestResVersions\":{\"gresVersion\":41426966,\"cresVersion\":41426971,\"dresVersion\":581},\"isHall\":1,\"isFastStart\":1,\"gameFastStartModeConfigResponses\":[{\"gameId\":\"g1046\",\"gameModeName\":null,\"gameMode\":null,\"gameCategory\":\"default\",\"friendFollowSwitch\":1,\"maxViewer\":10,\"joinMode\":0,\"partyStatus\":1,\"publicMaxMembers\":4,\"maxVisitors\":0,\"orientationEnabled\":0,\"manorEnabled\":0,\"publicMinStart\":2,\"privateMinStart\":2,\"minPartySupportedAppVersion\":0,\"fastStart\":1,\"isHall\":1,\"memberMax\":15,\"teamNum\":0,\"teamMem\":0,\"language\":null,\"bannerPic\":null,\"gameDetail\":null,\"weight\":0,\"gameCenter\":0,\"bigPartyMinS